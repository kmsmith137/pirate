  pipeline: offline
  processing:
    beam_batch_size: 1
    complete: true
    dm_reach_by_tree: [8]
    dm_tolerance: 1.5
    effective_grouping_halo_columns_by_tree: [18]
    grouping_association_domain: owner_plus_resolved_next_map_halo
    grouping_method: persistent_partition_representative
    halo_size: 2
    peakfinder: full_band
    requested_time_radius_by_tree: [9]
    snr_threshold: 10.0
    time_radius_by_tree: [9]
    time_tolerance: 1.5
    timeout_ms: 0
    timeout_policy: discard
    waist_bins_by_tree: [1]
  producer:
    argmax_encoding: pirate-1.5:t8-p8-m8-mu8
    config_yaml: "zone_nfreq: [8192, 8192, 6144, 2048, 3584]\nzone_freq_edges: [300,
      350, 450, 600, 800, 1500]\ntime_sample_ms: 0.99839999999999995\ntoplevel_tree_rank:
      16\ntime_samples_per_chunk: 2048\ndtype: float16\nfrequency_subband_counts:
      [0, 0, 0, 0, 1]\nprimary_trees:\n  - {num_early_triggers: 0, max_width: 32,
      wt_dm_downsampling: 64, wt_time_downsampling: 64}\nbeams_per_gpu: 1\nbeams_per_batch:
      1\nnum_active_batches: 1\nfuture_write_max_samples: 5000\nmax_gpu_clag: 5"
    dcores: [8]
    plan_yaml: "dtype: float16\nnfreq: 28160\nnt_in: 2048\ntoplevel_tree_rank: 16\nnum_primary_trees:
      1\nbeams_per_gpu: 1\nbeams_per_batch: 1\nnum_active_batches: 1\nstage1_dd_rank:
      [8]\nstage1_amb_rank: [8]\nntrees: 1\n\ntrees:\n\n  - tree_index: 0\n    ndm_out:
      4096\n    nt_out: 128\n    dm_min: 0\n    dm_max: 1478.5378354457471\n    trigger_frequency:
      300\n    primary_tree_index: 0\n    early_trigger_level: 0\n    amb_rank: 8\n
      \   dd_rank: 8\n    nt_ds: 2048\n    max_width: 32\n    dm_downsampling: 16\n
      \   time_downsampling: 16\n    nprofiles: 16\n    wt_dm_downsampling: 64\n    wt_time_downsampling:
      64\n    ndm_wt: 1024\n    nt_wt: 32\n    frequency_subband_counts: [0, 0, 0,
      0, 1]\n\nmega_ringbuf:\n  host_zones: 1.85 GiB\n  gpu_zones: 0.64 GiB\n  h2g
      bandwidth: 0.068 GB/s\n  g2h bandwidth: 0.068 GB/s\n  et_h2h bandwidth: 0.000
      GB/s\n  max_clag: 32\n  max_gpu_clag: 5\n  min_host_clag: 6\n  min_et_clag:
      32\n  min_et_headroom: 32\n\ndedispersion_outputs: 0.002 GB/s"
  startup_by_beam:
  - {beam_id: 1, producer_start_chunk_index: 0, status: authoritative}
  units: {dm: pc cm^-3, freq_hi_MHz: MHz, freq_lo_MHz: MHz, toa_sample_abs: full-resolution
      samples at complete-band low frequency, width_ms: ms, width_samp: full-resolution
      samples}
...
